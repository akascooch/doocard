{
  "name": "doocard-frontend",
  "version": "2.0.5",
  "private": true,
  "engines": {
    "node": "20.11.1",
    "npm": ">=10.0.0"
  },
  "engineStrict": true,
  "scripts": {
    "dev": "node --max-old-space-size=4096 node_modules/next/dist/bin/next dev",
    "build": "node --max-old-space-size=4096 node_modules/next/dist/bin/next build",
    "postbuild": "node scripts/sync-standalone.mjs",
    "start": "node --max-old-space-size=4096 node_modules/next/dist/bin/next start",
    "sync:standalone": "node scripts/sync-standalone.mjs",
    "lint": "next lint",
    "test:e2e": "cypress run",
    "test:e2e:open": "cypress open",
    "test:e2e:headed": "cypress run --headed",
    "test:e2e:chrome": "cypress run --browser chrome",
    "test:e2e:firefox": "cypress run --browser firefox",
    "test:e2e:edge": "cypress run --browser edge",
    "test:e2e:mobile": "cypress run --config viewportWidth=375,viewportHeight=667",
    "test:e2e:tablet": "cypress run --config viewportWidth=768,viewportHeight=1024",
    "test:e2e:ci": "cypress run --headless --browser chrome",
    "test:coverage": "cypress run --env coverage=true",
    "test:coverage:open": "cypress open --env coverage=true",
    "test:all": "npm run test:e2e",
    "test:smoke": "cypress run --spec 'cypress/e2e/auth.cy.ts'",
    "test:regression": "cypress run --spec 'cypress/e2e/**/*.cy.ts'"
  },
  "dependencies": {
    "@floating-ui/react-dom": "^2.1.6",
    "@headlessui/react": "^2.2.9",
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^3.3.4",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-tooltip": "^1.2.7",
    "axios": "^1.6.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "critters": "^0.0.23",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.13",
    "framer-motion": "^11.18.2",
    "jalaali-js": "^1.2.8",
    "jalaliday": "^3.1.0",
    "js-cookie": "^3.0.5",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^0.514.0",
    "motion-dom": "^12.23.21",
    "next": "14.1.0",
    "next-themes": "^0.2.1",
    "react": "^18",
    "react-date-object": "^2.1.9",
    "react-day-picker": "^9.8.1",
    "react-multi-date-picker": "^4.5.2",
    "react-dom": "^18",
    "react-hook-form": "^7.50.0",
    "recharts": "^2.15.3",
    "socket.io-client": "^4.8.1",
    "sonner": "^2.0.6",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.22.4",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@cypress/code-coverage": "^3.12.15",
    "@faker-js/faker": "^9.9.0",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "cypress": "^13.15.0",
    "eslint": "^8",
    "eslint-config-next": "14.1.0",
    "istanbul-lib-coverage": "^3.2.0",
    "nyc": "^15.1.0",
    "postcss": "^8",
    "tailwindcss": "^3.3.0",
    "typescript": "^5"
  }
}
