# Production template — copy to env.production on the server (never commit secrets)
NODE_ENV=production

NEXT_PUBLIC_API_URL=https://www.example.com/api
NEXT_PUBLIC_WS_URL=wss://www.example.com
BACKEND_URL=https://www.example.com/api

NEXT_PUBLIC_PWA_ENABLED=true
NEXT_PUBLIC_APP_NAME=Doocard Salon
NEXT_PUBLIC_APP_VERSION=1.2.4

NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Offline cashier mode — must be exactly "true" to enable
NEXT_PUBLIC_ENABLE_OFFLINE_MODE=false

NEXT_PUBLIC_ENABLE_PUSH_NOTIFICATIONS=true
