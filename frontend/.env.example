# Doocard Frontend Environment Variables (Next.js 14)
# Copy to .env.local for local development.

# -----------------------------------------------------------------------------
# API / Backend connectivity
# -----------------------------------------------------------------------------

# Public backend origin (no trailing slash). Used by browser-side axios and hooks.
# Fallback when unset: relative /api (Next.js rewrite to backend in dev).
NEXT_PUBLIC_API_URL=http://localhost:3001

# Server-side API route proxy target (Next.js /app/api/* routes).
# Fallback: NEXT_PUBLIC_API_URL, then http://127.0.0.1:3001
BACKEND_URL=http://localhost:3001

# WebSocket / Socket.IO origin for real-time notifications.
# Fallback: http://localhost:3001
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# -----------------------------------------------------------------------------
# Push notifications (Web Push / VAPID)
# -----------------------------------------------------------------------------

# Must match backend VAPID_PUBLIC_KEY. Leave empty to disable client subscription UI.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BHP4sJ--IgJepI-tImGr613Oqoy_bgKQHM8fZOLf4viipPbp8DKbHU2yD0VMSPtEff6rXyo5hPS8xTMvRN-ReoA

# -----------------------------------------------------------------------------
# Feature flags & app metadata
# -----------------------------------------------------------------------------

# Enable offline/PWA caching layer (true | false). Unset defaults to disabled.
NEXT_PUBLIC_ENABLE_OFFLINE_MODE=false

# Injected via next.config.js when not set in env:
# NEXT_PUBLIC_PWA_ENABLED=true
# NEXT_PUBLIC_APP_NAME=Doocard Salon
# NEXT_PUBLIC_APP_VERSION=1.0.0

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------

NODE_ENV=development
