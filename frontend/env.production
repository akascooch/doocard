# Production Environment Variables
NODE_ENV=production

# Backend URL (for production)
BACKEND_URL=http://doocardbarbershop.com/api
NEXT_PUBLIC_BACKEND_URL=http://doocardbarbershop.com/api

# PWA Settings
NEXT_PUBLIC_PWA_ENABLED=true
NEXT_PUBLIC_APP_NAME=MOVA Barbershop
NEXT_PUBLIC_APP_VERSION=1.0.0

# Analytics (optional)
# NEXT_PUBLIC_GA_ID=your-google-analytics-id
# NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn

# Feature Flags
NEXT_PUBLIC_ENABLE_OFFLINE_MODE=true
NEXT_PUBLIC_ENABLE_PUSH_NOTIFICATIONS=true
NEXT_PUBLIC_ENABLE_BACKGROUND_SYNC=true

# Performance
NEXT_PUBLIC_ENABLE_SERVICE_WORKER=true
NEXT_PUBLIC_CACHE_STRATEGY=network-first
NEXT_PUBLIC_OFFLINE_PAGE=/offline

# Security
NEXT_PUBLIC_CONTENT_SECURITY_POLICY=true
NEXT_PUBLIC_ENABLE_HTTPS_REDIRECT=false

# Monitoring
NEXT_PUBLIC_ENABLE_PERFORMANCE_MONITORING=true
NEXT_PUBLIC_ENABLE_ERROR_TRACKING=true
