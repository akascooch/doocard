# Production Environment Variables for MOVA Backend

# Application
NODE_ENV=production
PORT=3001
HOST=0.0.0.0

# Database
DATABASE_URL=postgresql://postgres:Lord7know$@localhost:5433/MOVA?schema=public
POSTGRES_DB=MOVA
POSTGRES_USER=postgres
POSTGRES_PASSWORD=Lord7know$
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Redis
REDIS_URL=redis://:mova_redis_password@redis:6379
REDIS_PASSWORD=mova_redis_password
REDIS_HOST=redis
REDIS_PORT=6379

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-here-make-it-very-long-and-random
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-secret-key-here
JWT_REFRESH_EXPIRES_IN=30d

# CORS & Security
CORS_ORIGIN=http://localhost:3000,https://your-domain.com
ALLOWED_ORIGINS=http://localhost:3000,https://your-domain.com
TRUST_PROXY=true

# File Upload
UPLOAD_DEST=/app/uploads
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf

# SMS Configuration
SMS_API_KEY=your-sms-api-key
SMS_LINE_NUMBER=your-sms-line-number
SMS_ENABLED=true
SMS_BEFORE_APPOINTMENT=60
SMS_AFTER_APPOINTMENT=0

# Email Configuration (if needed)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@your-domain.com

# Monitoring & Logging
LOG_LEVEL=info
LOG_FILE=/app/logs/app.log
ENABLE_METRICS=true
PROMETHEUS_PORT=9090

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Cache
CACHE_TTL=3600
CACHE_MAX_ITEMS=1000

# Session
SESSION_SECRET=your-session-secret-key-here
SESSION_TTL=86400

# Health Check
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=5000

# Backup
BACKUP_ENABLED=true
BACKUP_INTERVAL=86400
BACKUP_RETENTION_DAYS=30

# SSL/TLS (if using self-signed certificates)
SSL_KEY_PATH=/etc/ssl/private/nginx-selfsigned.key
SSL_CERT_PATH=/etc/ssl/certs/nginx-selfsigned.crt

# External Services
PAYMENT_GATEWAY_URL=https://payment-gateway.com
PAYMENT_GATEWAY_API_KEY=your-payment-api-key

# Feature Flags
ENABLE_SMS=true
ENABLE_EMAIL=true
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_ANALYTICS=true
ENABLE_BACKUP=true
