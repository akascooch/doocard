# Production template — copy to env.production on the server (never commit real secrets)
NODE_ENV=production
PORT=3001
HOST=0.0.0.0

DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/doocard?schema=public

JWT_SECRET=change-me-use-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_ROUNDS=12
CORS_ORIGIN=https://www.example.com
ALLOWED_ORIGINS=https://www.example.com
FRONTEND_URL=https://www.example.com
TRUST_PROXY=true

RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100

REDIS_URL=redis://127.0.0.1:6379

SMS_ENABLED=false
SMS_API_KEY=
SMS_SENDER_NUMBER=

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@example.com

LOG_LEVEL=warn
BACKUP_DEFAULT_PATH=/var/backups/doocard
