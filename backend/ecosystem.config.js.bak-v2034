/**
 * Local/reference PM2 config for backend only.
 * Production should use: deploy/templates/ecosystem.config.js
 * and load secrets from Backend/.env (never hardcode JWT/VAPID here).
 */
module.exports = {
  apps: [
    {
      name: 'doocard-backend',
      script: 'dist/src/main.js',
      instances: 1,
      autorestart: true,
      watch: false,
      max_memory_restart: '1G',
      env: {
        NODE_ENV: 'production',
        PORT: 3001,
      },
    },
  ],
};
