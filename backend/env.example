# Application Configuration
NODE_ENV=development
PORT=3001

# Database Configuration
DATABASE_URL="postgresql://postgres:change-me@localhost:5432/doocard?schema=public"
# Isolated integration database. Never set this equal to DATABASE_URL.
TEST_DATABASE_URL="postgresql://postgres:change-me@127.0.0.1:5432/doocard_test?schema=public"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PHONE="09120000000"
SEED_ADMIN_NAME="Local Admin"
SEED_ADMIN_PASSWORD="change-me"

# JWT Configuration
JWT_SECRET="your-super-secret-key-here-change-in-production"
JWT_EXPIRES_IN="24h"
# Existing production refresh rows keep their stored expiresAt; only NEW sessions get 30d.
JWT_REFRESH_EXPIRES_IN="30d"

# Security Configuration
BCRYPT_ROUNDS=12
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100

# SMS Configuration
SMS_PROVIDER=kavenegar
SMS_API_KEY="your-sms-api-key"
SMS_TEMPLATE_ID="your-template-id"

# Frontend URL
NEXT_PUBLIC_API_URL=http://localhost:3001

# Production Settings (uncomment in production)
# NODE_ENV=production
# CORS_ORIGIN=https://yourdomain.com
# DATABASE_URL="postgresql://user:password@host:port/database?schema=public"
