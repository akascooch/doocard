# Development Environment Variables for Doocard Backend (local PostgreSQL 17)

# Application
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Database
DATABASE_URL=postgresql://postgres:Lord7know$@localhost:5432/doocard?schema=public
POSTGRES_DB=doocard
POSTGRES_USER=postgres
POSTGRES_PASSWORD=Lord7know$
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Authentication
JWT_SECRET=dev-jwt-secret-key-change-in-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=dev-refresh-secret-key-change-in-production
JWT_REFRESH_EXPIRES_IN=365d

# CORS & Security
CORS_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
TRUST_PROXY=false

# File Upload
UPLOAD_DEST=./uploads
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf

# SMS Configuration
SMS_API_KEY=dev-sms-api-key
SMS_LINE_NUMBER=dev-sms-line-number
SMS_ENABLED=false
CHEQUE_DUE_SMS_ENABLED=false
SMS_BEFORE_APPOINTMENT=60
SMS_AFTER_APPOINTMENT=0

# Email Configuration (if needed)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=dev-email@gmail.com
SMTP_PASS=dev-app-password
EMAIL_FROM=noreply@dev-domain.com

# Monitoring & Logging
LOG_LEVEL=debug
LOG_FILE=./logs/app.log
ENABLE_METRICS=true
PROMETHEUS_PORT=9090

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=1000

# Cache
CACHE_TTL=3600
CACHE_MAX_ITEMS=1000

# Session
SESSION_SECRET=dev-session-secret-key-change-in-production
SESSION_TTL=86400

# Health Check
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=5000

# Backup
BACKUP_ENABLED=false
BACKUP_INTERVAL=86400
BACKUP_RETENTION_DAYS=7

# Feature Flags
ENABLE_SMS=false
ENABLE_EMAIL=false
ENABLE_PUSH_NOTIFICATIONS=false
ENABLE_ANALYTICS=false
ENABLE_BACKUP=false
