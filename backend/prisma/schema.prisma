generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  email               String?
  password            String
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  id                  Int                @id @default(autoincrement())
  name                String
  phone               String             @unique
  role                UserRole           @default(CUSTOMER)
  permissions         Permission[]
  paidAppointments    Appointment[]      @relation("AppointmentPaidBy")
  settledDebts        CustomerDebt[]     @relation("DebtSettledBy")
  customer            Customer?
  dayClosings         DayClosing[]
  employee            Employee?
  importJobs          ImportJob[]        @relation("ImportJobs")
  notifications       Notification[]     @relation("UserNotifications")
  pushSubscriptions   PushSubscription[] @relation("UserPushSubscriptions")
  refreshTokens       RefreshToken[]     @relation("UserRefreshTokens")
  smsLogs             SmsLog[]
  createdTransactions Transaction[]      @relation("TransactionCreator")
  financialReportsAccessUpdates FinancialReportsAccess[] @relation("FinancialReportsAccessUpdatedBy")
  createdTipSources   TipSource[]        @relation("TipSourceCreatedBy")
  voidedTipSources    TipSource[]        @relation("TipSourceVoidedBy")
  inventoryMovements  InventoryMovement[] @relation("InventoryMovementPerformedBy")
  productStockSubscriptions ProductStockSubscription[]
  adminDailyFrogs     AdminDailyFrog[]
  adminFrogRecurrences AdminFrogRecurrence[]
  adminPersonalExpenses AdminPersonalExpense[]
  adminExpenseCategories AdminExpenseCategory[]

  @@map("users")
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  token     String    @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime  @default(now())
  ipAddress String?
  userAgent String?
  isRevoked Boolean   @default(false)
  revokedAt DateTime?
  user      User      @relation("UserRefreshTokens", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

/// Phone OTP challenges for auth/booking. Codes are stored hashed only.
model OtpChallenge {
  id         String    @id @default(uuid())
  phone      String
  codeHash   String
  purpose    String    @default("LOGIN")
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, purpose])
  @@index([phone, createdAt])
  @@map("otp_challenges")
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation("UserPushSubscriptions", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model Employee {
  id                         Int                           @id @default(autoincrement())
  userId                     Int                           @unique
  specialty                  String?
  baseSalary                 Float                         @default(0)
  commissionRate             Float                         @default(0)
  lastCommissionSettlementAt DateTime?
  createdAt                  DateTime                      @default(now())
  updatedAt                  DateTime                      @updatedAt
  isActive                   Boolean                       @default(true)
  isDefault                  Boolean                       @default(false)
  /// When true, payroll uses SPECIAL_COMMISSION_POLICY (tax-first then split).
  isSpecialCommission        Boolean                       @default(false)
  /// Public landing showcase (CMS). Payroll fields above are unrelated.
  avatarUrl                  String?
  bio                        String?
  displayTitle               String?
  showOnLanding              Boolean                       @default(false)
  landingSortOrder           Int                           @default(0)
  appointments               Appointment[]
  blockedTimes               BlockedTime[]
  customers                  Customer[]
  employeeServices           EmployeeService[]
  user                       User                          @relation(fields: [userId], references: [id])
  salaries                   Salary[]
  tips                       Tip[]
  workSchedules              WorkSchedule[]
  transactions               Transaction[]
  commissionSettlements      EmployeeCommissionSettlement[]
  tipRecipientAppointments   Appointment[]                @relation("AppointmentTipRecipient")
  appointmentTipAllocations  AppointmentTipAllocation[]
  salaryRequests             EmployeeSalaryRequest[]
  manualTipRecipientSources  TipSource[]                  @relation("TipSourceIndividualRecipient")
  manualTipAllocations       ManualTipAllocation[]
  chequeLeaves               ChequeLeaf[]

  @@map("employees")
}

model Customer {
  id                  Int            @id @default(autoincrement())
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  notes               String?
  birthdate           DateTime?
  userId              Int            @unique
  preferredEmployeeId Int?
  preferredDate       DateTime?
  appointments        Appointment[]
  debts               CustomerDebt[]
  servicePackages     CustomerServicePackage[]
  loyaltyTransactions LoyaltyPointTransaction[]
  walletLedger        CustomerWalletLedger[]
  preferredEmployee   Employee?      @relation(fields: [preferredEmployeeId], references: [id])
  user                User           @relation(fields: [userId], references: [id])

  @@map("customers")
}

model Service {
  name                String
  price               Float
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  id                  Int                  @id @default(autoincrement())
  durationMinutes     Int
  description         String?
  appointmentServices AppointmentService[]
  appointments        Appointment[]
  employeeServices    EmployeeService[]
  packageTemplates    ServicePackageTemplate[]

  @@map("services")
}

model CalendarDate {
  id                 Int           @id @default(autoincrement())
  gregorianDate      DateTime      @unique @db.Date
  jalaliDate         String        @unique
  gregorianDayOfWeek Int
  jalaliDayOfWeek    Int
  isoWeek            Int?
  gregorianYear      Int
  gregorianMonth     Int
  gregorianDay       Int
  jalaliYear         Int
  jalaliMonth        Int
  jalaliDay          Int
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  appointments       Appointment[]

  @@index([gregorianDate])
  @@index([jalaliDate])
  @@index([gregorianYear, gregorianMonth])
  @@index([jalaliYear, jalaliMonth])
  @@map("calendar_dates")
}

model Appointment {
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  id                  Int                  @id @default(autoincrement())
  customerId          Int
  status              AppointmentStatus    @default(PENDING)
  employeeId          Int?
  serviceId           Int?
  accountId           Int?
  amount              BigInt?
  barberPayoutGrossAmount BigInt?
  settlementDeductionAmount BigInt?
  barberPayoutNetAmount BigInt?
  deductionPerAppointmentAmount BigInt?
  deletedAt           DateTime?
  durationMin         Int
  notes               String?
  paidAt              DateTime?
  paidBy              Int?
  paymentMethod       PaymentMethod?
  scheduledAt         DateTime
  services            Json
  tipAmount           BigInt?
  financiallyLockedAt DateTime?
  calendarDateId      Int?
  clientOpId          String?              @unique
  appointmentServices AppointmentService[]
  commissionSettlementAppointments EmployeeCommissionSettlementAppointment[]
  tipRecipientType    TipRecipientType?
  tipRecipientEmployeeId Int?
  tipStaffShareRial   BigInt?
  tipSalonShareRial   BigInt?
  tipTeamMemberIds    Json?
  tipAllocations      AppointmentTipAllocation[]
  tipRecipientEmployee Employee?           @relation("AppointmentTipRecipient", fields: [tipRecipientEmployeeId], references: [id])
  calendarDate        CalendarDate?        @relation(fields: [calendarDateId], references: [id])
  customer            Customer             @relation(fields: [customerId], references: [id])
  employee            Employee?            @relation(fields: [employeeId], references: [id])
  paidByUser          User?                @relation("AppointmentPaidBy", fields: [paidBy], references: [id])
  service             Service?             @relation(fields: [serviceId], references: [id])
  tips                Tip[]
  transactions        Transaction[]
  debts               CustomerDebt[]
  appointmentProducts AppointmentProduct[]
  packageConsumptions CustomerPackageConsumption[]

  @@index([customerId])
  @@index([employeeId])
  @@index([scheduledAt])
  @@index([status])
  @@index([deletedAt])
  @@index([calendarDateId])
  @@index([financiallyLockedAt])
  @@map("appointments")
}

model AppointmentService {
  id            Int         @id @default(autoincrement())
  appointmentId Int
  serviceId     Int
  price         Float
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service       Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([appointmentId, serviceId])
  @@map("appointment_services")
}

model EmployeeService {
  id         Int      @id @default(autoincrement())
  employeeId Int
  serviceId  Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([employeeId, serviceId])
  @@map("employee_services")
}

model Transaction {
  amount               BigInt
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  id                   Int                  @id @default(autoincrement())
  type                 TransactionType
  relatedId            Int?
  accountId            Int?
  categoryId           Int?
  employeeId           Int?
  createdBy            Int?
  currency             String               @default("IRR")
  deletedAt            DateTime?
  description          String?
  meta                 Json?
  occurredAt           DateTime             @default(now())
  paymentMethod        PaymentMethod?
  sourceId             Int?
  sourceType           String?
  destinationAccountId Int?
  account              BankAccount?         @relation("TransactionAccount", fields: [accountId], references: [id])
  category             TransactionCategory? @relation(fields: [categoryId], references: [id])
  employee             Employee?            @relation(fields: [employeeId], references: [id])
  createdByUser        User?                @relation("TransactionCreator", fields: [createdBy], references: [id])
  destinationAccount   BankAccount?         @relation("TransactionDestination", fields: [destinationAccountId], references: [id])
  appointment          Appointment?         @relation(fields: [relatedId], references: [id])
  chequeLeaves         ChequeLeaf[]
  commissionSettlementLinks EmployeeCommissionSettlementTransaction[]
  finalCommissionSettlement EmployeeCommissionSettlement? @relation("SettlementFinalTransaction")
  salaryRequestPayment      EmployeeSalaryRequest? @relation("SalaryRequestPayment")

  @@index([sourceType, sourceId])
  @@index([type, occurredAt])
  @@index([accountId])
  @@index([destinationAccountId])
  @@index([categoryId])
  @@index([deletedAt])
  @@index([employeeId, occurredAt])
  @@index([employeeId, type, deletedAt])
  @@map("transactions")
}

model TransactionCategory {
  id               Int                   @id @default(autoincrement())
  name             String
  code             String?               @unique
  requiresEmployee Boolean               @default(false)
  type             TransactionType
  description      String?
  parentId         Int?
  isActive         Boolean               @default(true)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  deletedAt        DateTime?
  parent           TransactionCategory?  @relation("CategoryParent", fields: [parentId], references: [id])
  children         TransactionCategory[] @relation("CategoryParent")
  transactions     Transaction[]

  @@map("transaction_categories")
}

model EmployeeCommissionSettlement {
  id                            Int                                    @id @default(autoincrement())
  employeeId                    Int
  periodStartAt                 DateTime
  periodEndAt                   DateTime
  periodStartJalali             String?
  periodEndJalali               String?
  commissionPercentage          Float
  appointmentCount              Int
  grossAppointmentTotalRial     BigInt
  grossEmployeeShareRial        BigInt
  deductionPerAppointmentRial   BigInt
  totalAppointmentDeductionRial BigInt
  priorWithdrawalsTotalRial     BigInt
  netPayableRial                BigInt
  settlementTransactionId       Int?                                   @unique
  settledAt                     DateTime                               @default(now())
  createdByUserId               Int?
  status                        EmployeeCommissionSettlementStatus     @default(ACTIVE)
  reversedAt                    DateTime?
  reversedByUserId              Int?
  notes                         String?
  createdAt                     DateTime                               @default(now())
  updatedAt                     DateTime                               @updatedAt
  employee                      Employee                               @relation(fields: [employeeId], references: [id])
  settlementTransaction         Transaction?                           @relation("SettlementFinalTransaction", fields: [settlementTransactionId], references: [id])
  appointments                  EmployeeCommissionSettlementAppointment[]
  priorTransactions             EmployeeCommissionSettlementTransaction[]
  paidTipAllocations            AppointmentTipAllocation[]
  paidManualTipAllocations      ManualTipAllocation[]

  @@index([employeeId, status, settledAt])
  @@map("employee_commission_settlements")
}

model EmployeeCommissionSettlementAppointment {
  settlementId             Int
  appointmentId            Int
  appointmentAmountRial    BigInt
  employeeShareRial        BigInt
  appointmentDeductionRial BigInt
  settlement               EmployeeCommissionSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  appointment              Appointment                  @relation(fields: [appointmentId], references: [id])

  @@id([settlementId, appointmentId])
  @@unique([appointmentId])
  @@map("employee_commission_settlement_appointments")
}

model EmployeeCommissionSettlementTransaction {
  settlementId  Int
  transactionId Int
  amountRial    BigInt
  role          EmployeeCommissionSettlementTransactionRole
  settlement    EmployeeCommissionSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  transaction   Transaction                @relation(fields: [transactionId], references: [id])

  @@id([settlementId, transactionId])
  @@map("employee_commission_settlement_transactions")
}

model BankAccount {
  id                      Int           @id @default(autoincrement())
  name                    String
  provider                String?
  accountNo               String?
  cardNo                  String?
  iban                    String?
  isDefault               Boolean       @default(false)
  isActive                Boolean       @default(true)
  balance                 BigInt        @default(0)
  currency                String        @default("IRR")
  description             String?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  deletedAt               DateTime?
  transactions            Transaction[] @relation("TransactionAccount")
  destinationTransactions Transaction[] @relation("TransactionDestination")
  chequebooks             Chequebook[]
  salaryRequestPayments   EmployeeSalaryRequest[]

  @@map("bank_accounts")
}

model Chequebook {
  id            Int          @id @default(autoincrement())
  bankAccountId Int
  serialNumber  String?
  startNumber   Int
  endNumber     Int
  leafCount     Int
  issuedAt      DateTime?
  isActive      Boolean      @default(true)
  description   String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?
  bankAccount   BankAccount  @relation(fields: [bankAccountId], references: [id])
  leaves        ChequeLeaf[]

  @@index([bankAccountId])
  @@index([deletedAt])
  @@map("chequebooks")
}

model ChequeLeaf {
  id            Int                @id @default(autoincrement())
  chequebookId  Int
  leafNumber    Int
  status        ChequeLeafStatus   @default(BLANK)
  /** NORMAL = ordinary cheque; GUARANTEE = ضمانت */
  category      ChequeLeafCategory @default(NORMAL)
  amount        BigInt?
  payee         String?
  /// Structured payee kind; null keeps legacy free-text cheques unchanged.
  payeeKind     ChequePayeeKind?
  employeeId    Int?
  dueDate       DateTime?
  issuedAt      DateTime?
  clearedAt     DateTime?
  transactionId Int?
  description   String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  deletedAt     DateTime?
  chequebook    Chequebook         @relation(fields: [chequebookId], references: [id])
  transaction   Transaction?       @relation(fields: [transactionId], references: [id])
  employee      Employee?          @relation(fields: [employeeId], references: [id])

  @@unique([chequebookId, leafNumber])
  @@index([chequebookId, status])
  @@index([category])
  @@index([payeeKind])
  @@index([employeeId])
  @@index([deletedAt])
  @@index([dueDate, status])
  @@map("cheque_leaves")
}

model Category {
  id        Int          @id @default(autoincrement())
  name      String
  type      CategoryType
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@map("categories")
}

model Tip {
  id            Int         @id @default(autoincrement())
  appointmentId Int
  employeeId    Int
  amount        Float
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  employee      Employee    @relation(fields: [employeeId], references: [id])

  @@map("tips")
}

model AppointmentTipAllocation {
  id                 Int                         @id @default(autoincrement())
  appointmentId      Int
  employeeId         Int
  amountRial         BigInt
  paidInSettlementId Int?
  createdAt          DateTime                    @default(now())
  appointment        Appointment                 @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  employee           Employee                    @relation(fields: [employeeId], references: [id])
  paidInSettlement   EmployeeCommissionSettlement? @relation(fields: [paidInSettlementId], references: [id])

  @@index([appointmentId])
  @@index([employeeId])
  @@index([paidInSettlementId])
  @@map("appointment_tip_allocations")
}

/// Manual tip ledger (not fake appointments). Appointment-origin tips stay on Appointment + AppointmentTipAllocation.
enum TipSourceOrigin {
  MANUAL
}

enum TipSourceStatus {
  ACTIVE
  VOIDED
}

model TipSource {
  id                  Int               @id @default(autoincrement())
  origin              TipSourceOrigin   @default(MANUAL)
  tipType             TipRecipientType
  amountRial          BigInt
  effectiveBusinessAt DateTime
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  createdByUserId     Int
  note                String?
  idempotencyKey      String            @unique
  status              TipSourceStatus   @default(ACTIVE)
  voidedAt            DateTime?
  voidedByUserId      Int?
  voidReason          String?
  recipientEmployeeId Int?
  teamMemberIds       Json?
  createdBy           User              @relation("TipSourceCreatedBy", fields: [createdByUserId], references: [id])
  voidedBy            User?             @relation("TipSourceVoidedBy", fields: [voidedByUserId], references: [id])
  recipientEmployee   Employee?         @relation("TipSourceIndividualRecipient", fields: [recipientEmployeeId], references: [id])
  allocations         ManualTipAllocation[]

  @@index([effectiveBusinessAt])
  @@index([status, tipType])
  @@index([createdByUserId])
  @@map("tip_sources")
}

model ManualTipAllocation {
  id                 Int                          @id @default(autoincrement())
  tipSourceId        Int
  employeeId         Int
  amountRial         BigInt
  paidInSettlementId Int?
  createdAt          DateTime                     @default(now())
  tipSource          TipSource                    @relation(fields: [tipSourceId], references: [id], onDelete: Cascade)
  employee           Employee                     @relation(fields: [employeeId], references: [id])
  paidInSettlement   EmployeeCommissionSettlement? @relation(fields: [paidInSettlementId], references: [id])

  @@unique([tipSourceId, employeeId])
  @@index([employeeId])
  @@index([paidInSettlementId])
  @@map("manual_tip_allocations")
}

model Salary {
  id          Int          @id @default(autoincrement())
  amount      Float
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  employeeId  Int
  periodEnd   DateTime
  periodStart DateTime
  status      SalaryStatus @default(PENDING)
  employee    Employee     @relation(fields: [employeeId], references: [id])

  @@map("salaries")
}

model EmployeeSalaryRequest {
  id                     Int                        @id @default(autoincrement())
  employeeId             Int
  requestType            EmployeeSalaryRequestType
  status                 EmployeeSalaryRequestStatus @default(PENDING)
  upToJalali             String
  periodStartJalali      String?
  requestedAmountRial    BigInt
  availableAtRequestRial BigInt
  snapshotJson           Json
  destinationNote        String?
  allowNegative          Boolean                    @default(false)
  reviewedByUserId       Int?
  reviewedAt             DateTime?
  paidByUserId           Int?
  paidAt                 DateTime?
  paidBankAccountId      Int?
  paymentTransactionId   Int?                       @unique
  settlementId           Int?
  rejectionReason        String?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  employee               Employee                   @relation(fields: [employeeId], references: [id])
  paymentTransaction     Transaction?               @relation("SalaryRequestPayment", fields: [paymentTransactionId], references: [id])
  paidBankAccount        BankAccount?               @relation(fields: [paidBankAccountId], references: [id])

  @@index([employeeId, status, createdAt])
  @@index([status, createdAt])
  @@map("employee_salary_requests")
}

model Permission {
  id        Int      @id @default(autoincrement())
  role      String
  userId    Int?
  page      String
  feature   String
  canView   Boolean  @default(false)
  canEdit   Boolean  @default(false)
  canDelete Boolean  @default(false)
  canCreate Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id])

  @@index([role, page, feature])
  @@index([userId, page, feature])
}

model SmsLog {
  id          Int      @id @default(autoincrement())
  phoneNumber String
  message     String
  status      String
  error       String?
  createdAt   DateTime @default(now())
  customerId  Int?
  user        User?    @relation(fields: [customerId], references: [id])

  @@map("sms_logs")
}

model SmsSettings {
  id                    Int      @id @default(autoincrement())
  apiKey                String?
  lineNumber            String?
  isEnabled             Boolean  @default(false)
  sendBeforeAppointment Int      @default(60)
  sendAfterAppointment  Int      @default(0)
  defaultMessage        String?
  updatedAt             DateTime

  @@map("sms_settings")
}

model SmsTemplate {
  id          Int      @id @default(autoincrement())
  /// Application template key (catalog name). Uniqueness enforced by seed/app logic.
  name        String
  content     String
  /// Human-readable purpose for admin UI (does not affect send).
  description String?
  variables   String[]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime

  @@map("sms_templates")
}

model SmsEvent {
  id            Int       @id @default(autoincrement())
  appointmentId Int?
  to            String
  message       String?
  status        String
  providerResp  String?
  attempts      Int       @default(0)
  lastAttemptAt DateTime?
  /// Unique send key for idempotency (e.g. customer.welcome:42)
  dedupeKey     String?   @unique
  eventKey      String?
  /// In-app template key used for this send (not sms.ir template id)
  templateKey   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([appointmentId])
  @@index([status])
  @@index([createdAt])
  @@index([eventKey])
  @@index([templateKey])
  @@map("sms_events")
}

/// Per-event SMS allow-list (admin-toggleable). Missing row → DEFAULT_SMS_POLICY.
model SmsNotificationRule {
  id         Int      @id @default(autoincrement())
  eventKey   String   @unique
  label      String?
  smsEnabled Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("sms_notification_rules")
}

model HomepageDetails {
  id            Int      @id @default(autoincrement())
  about         String?
  team          String?
  products      String?
  trainings     String?
  testimonials  String?
  contact       String?
  heroTitle     String?
  heroSubtitle  String?
  phone         String?
  address       String?
  instagramUrl  String?
  workingHours  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("homepage_details")
}

model LandingSlide {
  id        Int      @id @default(autoincrement())
  imageUrl  String
  title     String?
  subtitle  String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("landing_slides")
}

model DayClosing {
  id            Int       @id @default(autoincrement())
  date          DateTime  @unique
  totalIncome   Float     @default(0)
  totalExpense  Float     @default(0)
  totalTips     Float     @default(0)
  totalSalaries Float     @default(0)
  isClosed      Boolean   @default(false)
  closedAt      DateTime?
  closedBy      Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  closedByUser  User?     @relation(fields: [closedBy], references: [id])

  @@map("day_closings")
}

model CustomerDebt {
  id            Int          @id @default(autoincrement())
  customerId    Int
  /** Optional FK for appointment-sourced debts (preferred over soft sourceId alone). */
  appointmentId Int?
  amount        BigInt
  sourceType    String?
  sourceId      Int?
  description   String?
  createdAt     DateTime     @default(now())
  dueAt         DateTime?
  settledAt     DateTime?
  settledBy     Int?
  meta          Json?
  customer      Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  settledByUser User?        @relation("DebtSettledBy", fields: [settledBy], references: [id])

  @@unique([sourceType, sourceId])
  @@index([customerId])
  @@index([settledAt])
  @@index([appointmentId])
  @@map("customer_debts")
}

model WorkSchedule {
  id         Int      @id @default(autoincrement())
  employeeId Int
  weekday    Int
  startTime  String
  endTime    String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, weekday, startTime])
  @@index([employeeId, weekday])
  @@map("work_schedules")
}

model BlockedTime {
  id         Int      @id @default(autoincrement())
  employeeId Int
  startAt    DateTime
  endAt      DateTime
  reason     String?
  createdBy  Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, startAt, endAt])
  @@map("blocked_times")
}

model Notification {
  id            Int              @id @default(autoincrement())
  title         String
  message       String
  type          NotificationType
  roleTarget    String?
  userIdTarget  Int?
  relatedEntity String?
  isRead        Boolean          @default(false)
  readAt        DateTime?
  createdAt     DateTime         @default(now())
  user          User?            @relation("UserNotifications", fields: [userIdTarget], references: [id], onDelete: Cascade)

  @@index([userIdTarget, isRead])
  @@index([roleTarget, isRead])
  @@index([createdAt])
  @@map("notifications")
}

model ImportJob {
  id         Int          @id @default(autoincrement())
  userId     Int
  entity     String
  filename   String
  batchId    String       @unique
  totalRows  Int          @default(0)
  created    Int          @default(0)
  updated    Int          @default(0)
  failed     Int          @default(0)
  status     ImportStatus @default(PENDING)
  logPath    String?
  metadata   Json?
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime     @default(now())
  user       User         @relation("ImportJobs", fields: [userId], references: [id])

  @@index([userId, status])
  @@index([batchId])
  @@index([createdAt])
  @@map("import_jobs")
}

