  updatedByUserId Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  updatedBy       User?    @relation("FinancialReportsAccessUpdatedBy", fields: [updatedByUserId], references: [id])

  @@map("financial_reports_access")
}

model SystemSettings {
  id                       Int       @id @default(1)
  autoBackupEnabled        Boolean   @default(false)
  backupIntervalDays       Int       @default(7)
  backupPath               String?
  lastBackupDate           DateTime?
  loyaltyRateRialPerPoint  Int       @default(1000)
  loyaltyMinRedeemPoints   Int       @default(100)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@map("system_settings")
}

enum InventoryMovementType {
  IN
  OUT
  ADJUSTMENT
  APPOINTMENT_SALE
  REVERSAL
}

model ProductCategory {
  id        Int       @id @default(autoincrement())
  name      String
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@map("product_categories")
}

model Product {
  id             Int       @id @default(autoincrement())
  name           String
  sku            String?   @unique
  barcode        String?   @unique
  description    String?
  priceRial      BigInt
  isPriceVisible Boolean   @default(false)
  stock          Int       @default(0)
  lowStockAlert  Int?
  categoryId     Int?
  isActive       Boolean   @default(true)
  images         Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  category       ProductCategory? @relation(fields: [categoryId], references: [id])
  movements      InventoryMovement[]
  packagings     ProductPackaging[]
  appointmentProducts AppointmentProduct[]
  orders         OrderItem[]
  stockSubscriptions ProductStockSubscription[]

  @@index([categoryId])
  @@index([isActive])
  @@map("products")
}

model ProductPackaging {
  id              Int       @id @default(autoincrement())
  productId       Int
  name            String
  unitLabel       String
  unitsPerPackage Int
  isActive        Boolean   @default(true)
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  product         Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  movements       InventoryMovement[]
  appointmentProducts AppointmentProduct[]
  orderItems      OrderItem[]

  @@index([productId, isActive])
  @@map("product_packagings")
}

model InventoryMovement {
  id            Int                   @id @default(autoincrement())
  productId     Int
  type          InventoryMovementType
  quantity      Int
  unitCostRial  BigInt?
  reason        String?
  referenceType String?
  referenceId   Int?
  performedById Int?
  createdAt     DateTime              @default(now())
  product       Product               @relation(fields: [productId], references: [id])
  performedBy   User?                 @relation("InventoryMovementPerformedBy", fields: [performedById], references: [id])
  packagingId     Int?
  packagingName   String?
  packagingUnit   String?
  unitsPerPackage Int?
  packaging       ProductPackaging? @relation(fields: [packagingId], references: [id])

  @@index([productId, createdAt])
  @@index([referenceType, referenceId])
  @@map("inventory_movements")
}

model AppointmentProduct {
  id            Int         @id @default(autoincrement())
  appointmentId Int
  productId     Int
  quantity      Int
  unitPriceRial BigInt
  lineTotalRial BigInt
  createdAt     DateTime    @default(now())
  packagingId   Int?
  packagingName String?
  packagingUnit String?
  unitsPerPackage Int?
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  product       Product     @relation(fields: [productId], references: [id])
  packaging     ProductPackaging? @relation(fields: [packagingId], references: [id])

  @@index([appointmentId])
  @@map("appointment_products")
}

enum OrderStatus {
  AWAITING_QUOTE
  PENDING_VERIFICATION
  PAID
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
}

/// Shop card-to-card orders. Isolated from salon Transaction / AppointmentProduct.
model Order {
  id               String      @id @default(uuid())
  orderNumber      String      @unique
  customerName     String
  customerPhone    String
  customerAddress  String?
  customerNotes    String?
  totalAmountRial  BigInt
  status           OrderStatus @default(PENDING_VERIFICATION)
  receiptImageUrl  String?
  trackingCode     String?
  adminNotes       String?
  verifiedAt       DateTime?
  items            OrderItem[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([status, createdAt])
  @@index([createdAt])
  @@index([customerPhone])
  @@map("orders")
}

model OrderItem {
  id            Int      @id @default(autoincrement())
  orderId       String
  productId     Int
  productTitle  String
  unitPriceRial BigInt
  quantity      Int
  lineTotalRial BigInt
  createdAt     DateTime @default(now())
  packagingId   Int?
  packagingName String?
  packagingUnit String?
  unitsPerPackage Int?
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  packaging     ProductPackaging? @relation(fields: [packagingId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

enum StockWaitlistChannel {
  SMS
  IN_APP
}

enum StockWaitlistStatus {
  ACTIVE
  CANCELLED
  NOTIFIED
}

/// Customer waitlist for out-of-stock shop products. Notifications are Phase D; this row is lifecycle only.
/// ACTIVE uniqueness is a partial unique index in SQL: (productId, userId) WHERE status = 'ACTIVE'.
model ProductStockSubscription {
  id          String               @id @default(uuid())
  productId   Int
  userId      Int
  /// Normalized Iran mobile snapshot from User.phone at subscribe time.
  phone       String
  channel     StockWaitlistChannel @default(SMS)
  status      StockWaitlistStatus  @default(ACTIVE)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  cancelledAt DateTime?
  notifiedAt  DateTime?
  product     Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([productId, status])
  @@index([phone, status])
  @@map("product_stock_subscriptions")
}

enum AdminFrogStatus {
  PENDING
  IN_PROGRESS
  DONE
}

enum AdminPersonalExpenseCategory {
  SALON_SUPPLIES
  FOOD_REFRESHMENT
  PETTY_CASH
  UTILITY
  PERSONAL
}

/// Admin personal frog / to-do items. Multiple tasks per Tehran civil day are allowed.
model AdminDailyFrog {
  id             String          @id @default(uuid())
  userId         Int
  dateKey        String
  title          String
  description    String?
  status         AdminFrogStatus @default(PENDING)
  isCompleted    Boolean         @default(false)
  completedAt    DateTime?
  /// Instant the task is due (UTC). Combined from Tehran dateKey + HH:mm.
  scheduledAt    DateTime
  reminderSent   Boolean         @default(false)
  reminderSentAt DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dateKey])
  @@index([userId, isCompleted])
  @@index([isCompleted, reminderSent, scheduledAt])
  @@map("admin_daily_frogs")
}

/// Recurring template for the admin's frog list. One generated row per rule per Tehran day.
model AdminFrogRecurrence {
  id          String    @id @default(uuid())
  userId      Int
  title       String
  description String?
  frequency   String
  dayOfWeek   Int?
  isActive    Boolean   @default(true)
  lastRunAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@map("admin_frog_recurrences")
}

/// Admin-owned petty-cash category labels. Additive; enum `category` stays on expenses.
model AdminExpenseCategory {
  id         String    @id @default(uuid())
  userId     Int
  name       String
  isDefault  Boolean   @default(false)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses   AdminPersonalExpense[]

  @@unique([userId, name])
  @@index([userId])
  @@map("admin_expense_categories")
}

/// Admin petty-cash / personal spend — not linked to customer invoices.
model AdminPersonalExpense {
  id          String                         @id @default(uuid())
  userId      Int
  amount      BigInt
  category    AdminPersonalExpenseCategory
  categoryId  String?
  title       String
  description String?
  dateKey     String
  occurredAt  DateTime                       @default(now())
  createdAt   DateTime                       @default(now())
  updatedAt   DateTime                       @updatedAt
  deletedAt   DateTime?
  user        User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryRel AdminExpenseCategory?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId, dateKey])
  @@index([userId, category])
  @@index([userId, occurredAt])
  @@index([userId, deletedAt])
  @@index([categoryId])
  @@map("admin_personal_expenses")
}

enum CustomerPackageStatus {
  ACTIVE
  EXHAUSTED
  EXPIRED
  CANCELLED
}

/// Sellable session bundle. Price is integer rials (not Service.price Float).
model ServicePackageTemplate {
  id             String                   @id @default(uuid())
  title          String
  description    String?
  priceRial      BigInt
  validityDays   Int
  totalSessions  Int
  serviceId      Int
  isActive       Boolean                  @default(true)
  archivedAt     DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  service        Service                  @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  packages       CustomerServicePackage[]

  @@index([serviceId])
  @@index([isActive])
  @@map("service_package_templates")
}

/// A customer's owned copy of a package. customerId is Customer.id, not User.id.
model CustomerServicePackage {
  id                 String                       @id @default(uuid())
  customerId         Int
  packageTemplateId  String
  totalSessions      Int
  remainingSessions  Int
  expiresAt          DateTime
  status             CustomerPackageStatus        @default(ACTIVE)
  paymentMethod      String
  notes              String?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  customer           Customer                     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  template           ServicePackageTemplate       @relation(fields: [packageTemplateId], references: [id], onDelete: Restrict)
  consumptions       CustomerPackageConsumption[]

  @@index([customerId, status])
  @@map("customer_service_packages")
}

model CustomerPackageConsumption {
  id                 String                 @id @default(uuid())
  customerPackageId  String
  appointmentId      Int
  createdAt          DateTime               @default(now())
  customerPackage    CustomerServicePackage @relation(fields: [customerPackageId], references: [id], onDelete: Cascade)
  appointment        Appointment            @relation(fields: [appointmentId], references: [id], onDelete: Restrict)

  @@unique([appointmentId])
  @@unique([customerPackageId, appointmentId])
  @@map("customer_package_consumptions")
}

model LoyaltyPointTransaction {
  id          String   @id @default(uuid())
  customerId  Int
  points      Int
  action      String
  referenceId String?
  notes       String?
  createdAt   DateTime @default(now())
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
  @@map("loyalty_point_transactions")
}

/// Isolated store-credit ledger. Not a salon BankAccount and not appointment settlement.
model CustomerWalletLedger {
  id          String   @id @default(uuid())
  customerId  Int
  amount      BigInt
  type        String
  source      String
  referenceId String?
  notes       String?
  createdAt   DateTime @default(now())
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
  @@map("customer_wallet_ledger")
}

