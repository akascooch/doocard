import { Injectable } from '@nestjs/common';
import { PrismaService } from '../prisma/prisma.service';
import * as bcrypt from 'bcrypt';
import * as fs from 'fs';
import * as path from 'path';

@Injectable()
export class SettingsService {
  constructor(private readonly prisma: PrismaService) {}

  async getLogo() {
    try {
      const logoSetting = await this.prisma.setting.findUnique({
        where: { key: 'logo_path' }
      });

      if (logoSetting && logoSetting.value) {
        return { 
          path: logoSetting.value,
          exists: fs.existsSync(path.join(process.cwd(), 'uploads', 'logos', path.basename(logoSetting.value)))
        };
      }

      // Return default logo
      return { 
        path: '/uploads/logos/default-logo.png',
        exists: true,
        isDefault: true
      };
    } catch (error) {
      console.error('Error getting logo:', error);
      return { 
        path: '/uploads/logos/default-logo.png',
        exists: true,
        isDefault: true
      };
    }
  }

  async uploadLogo(file: Express.Multer.File) {
    try {
      // Create uploads directory if it doesn't exist
      const uploadsDir = path.join(process.cwd(), 'uploads', 'logos');
      if (!fs.existsSync(uploadsDir)) {
        fs.mkdirSync(uploadsDir, { recursive: true });
      }

      // Generate unique filename
      const timestamp = Date.now();
      const fileExtension = path.extname(file.originalname);
      const filename = `logo-${timestamp}${fileExtension}`;
      const filePath = path.join(uploadsDir, filename);

      // Save file
      fs.writeFileSync(filePath, file.buffer);

      // Update database setting
      const logoPath = `/uploads/logos/${filename}`;
      
      await this.prisma.setting.upsert({
        where: { key: 'logo_path' },
        update: { value: logoPath },
        create: { key: 'logo_path', value: logoPath }
      });

      // Update other logo-related settings
      await this.prisma.setting.upsert({
        where: { key: 'logo_filename' },
        update: { value: filename },
        create: { key: 'logo_filename', value: filename }
      });

      await this.prisma.setting.upsert({
        where: { key: 'logo_uploaded_at' },
        update: { value: new Date().toISOString() },
        create: { key: 'logo_uploaded_at', value: new Date().toISOString() }
      });

      return {
        success: true,
        filename: filename,
        path: logoPath,
        message: 'لوگو با موفقیت آپلود شد'
      };
    } catch (error) {
      console.error('Error uploading logo:', error);
      throw new Error('خطا در آپلود لوگو');
    }
  }

  async deleteLogo() {
    try {
      const logoSetting = await this.prisma.setting.findUnique({
        where: { key: 'logo_path' }
      });

      if (logoSetting && logoSetting.value) {
        // Delete file
        const filePath = path.join(process.cwd(), logoSetting.value);
        if (fs.existsSync(filePath)) {
          fs.unlinkSync(filePath);
        }

        // Delete from database
        await this.prisma.setting.deleteMany({
          where: {
            key: { in: ['logo_path', 'logo_filename', 'logo_uploaded_at'] }
          }
        });

        return {
          success: true,
          message: 'لوگو با موفقیت حذف شد'
        };
      }

      return {
        success: false,
        message: 'لوگویی برای حذف یافت نشد'
      };
    } catch (error) {
      console.error('Error deleting logo:', error);
      throw new Error('خطا در حذف لوگو');
    }
  }

  async getLogoInfo() {
    try {
      const logoPath = await this.prisma.setting.findUnique({
        where: { key: 'logo_path' }
      });

      const logoFilename = await this.prisma.setting.findUnique({
        where: { key: 'logo_filename' }
      });

      const logoUploadedAt = await this.prisma.setting.findUnique({
        where: { key: 'logo_uploaded_at' }
      });

      if (logoPath && logoPath.value) {
        const filePath = path.join(process.cwd(), logoPath.value);
        const stats = fs.existsSync(filePath) ? fs.statSync(filePath) : null;

        return {
          path: logoPath.value,
          filename: logoFilename?.value || '',
          uploadedAt: logoUploadedAt?.value || '',
          size: stats ? stats.size : 0,
          exists: !!stats
        };
      }

      return {
        path: '/uploads/logos/default-logo.png',
        filename: 'default-logo.png',
        uploadedAt: '',
        size: 0,
        exists: true,
        isDefault: true
      };
    } catch (error) {
      console.error('Error getting logo info:', error);
      return {
        path: '/uploads/logos/default-logo.png',
        filename: 'default-logo.png',
        uploadedAt: '',
        size: 0,
        exists: true,
        isDefault: true
      };
    }
  }

