  async createBackup() {
    try {
      console.log('🔄 شروع ایجاد پشتیبان کامل...');
      
      const backupData = {
        timestamp: new Date().toISOString(),
        version: '1.0.0',
        database: 'MOVA',
        tables: {}
      };

      // Backup Users
      console.log('📋 پشتیبان‌گیری از کاربران...');
      backupData.tables['users'] = await this.prisma.user.findMany({
        select: {
          id: true,
          email: true,
          firstName: true,
          lastName: true,
          phoneNumber: true,
          role: true,
          isActive: true,
          createdAt: true,
          updatedAt: true,
        }
      });

      // Backup Customers
      console.log('📋 پشتیبان‌گیری از مشتریان...');
      backupData.tables['customers'] = await this.prisma.customer.findMany();

      // Backup Barbers
      console.log('📋 پشتیبان‌گیری از آرایشگران...');
      backupData.tables['barbers'] = await this.prisma.barber.findMany();

      // Backup Services
      console.log('📋 پشتیبان‌گیری از خدمات...');
      backupData.tables['services'] = await this.prisma.service.findMany();

      // Backup Appointments
      console.log('📋 پشتیبان‌گیری از نوبت‌ها...');
      backupData.tables['appointments'] = await this.prisma.appointment.findMany();

      // Backup Financial Categories
      console.log('📋 پشتیبان‌گیری از دسته‌بندی‌های مالی...');
      // TODO: Accounting functionality temporarily disabled
      // backupData.tables['financialCategories'] = await this.prisma.financialCategory.findMany();

      // Backup Financial Entries
      console.log('📋 پشتیبان‌گیری از ورودی‌های مالی...');
      // TODO: Accounting functionality temporarily disabled
      // backupData.tables['financialEntries'] = await this.prisma.financialEntry.findMany();

      // Backup Bank Accounts
      console.log('📋 پشتیبان‌گیری از حساب‌های بانکی...');
      backupData.tables['bankAccounts'] = await this.prisma.bankAccount.findMany();

      // Backup Transactions
      console.log('📋 پشتیبان‌گیری از تراکنش‌ها...');
      backupData.tables['transactions'] = await this.prisma.transaction.findMany();

      // Backup SMS Settings
      console.log('📋 پشتیبان‌گیری از تنظیمات SMS...');
      backupData.tables['smsSettings'] = await this.prisma.smsSettings.findMany();

      // Backup Permissions
      console.log('📋 پشتیبان‌گیری از دسترسی‌ها...');
      backupData.tables['permissions'] = await this.prisma.permission.findMany();

      // Backup Barber-Service Relationships
      console.log('📋 پشتیبان‌گیری از روابط آرایشگر-خدمات...');
      backupData.tables['barberServices'] = await this.prisma.$queryRaw`
        SELECT * FROM "_BarberToService"
      `;

      console.log('✅ پشتیبان کامل ایجاد شد');
      
      return backupData;
    } catch (error) {
      console.error('❌ خطا در ایجاد پشتیبان:', error);
      throw new Error('خطا در ایجاد پشتیبان');
    }
  }

  async restoreBackup(backupData: any) {
    try {
      console.log('🔄 شروع بازیابی از پشتیبان...');
      
      // Validate backup data
      if (!backupData.tables || !backupData.timestamp) {
        throw new Error('فایل پشتیبان نامعتبر است');
      }

      // Start transaction
      await this.prisma.$transaction(async (prisma) => {
        // Clear existing data first
        console.log('🗑️ پاک کردن داده‌های موجود...');
        await this.clearAllData(prisma);

        // Restore Users
        if (backupData.tables.users) {
          console.log('📋 بازیابی کاربران...');
          for (const user of backupData.tables.users) {
            // Hash password if it exists, otherwise use default
            const password = user.password || '123456';
            const hashedPassword = await bcrypt.hash(password, 10);
            
            await prisma.user.create({
              data: {
                ...user,
                password: hashedPassword,
              }
            });
          }
        }

        // Restore Customers
        if (backupData.tables.customers) {
          console.log('📋 بازیابی مشتریان...');
          await prisma.customer.createMany({
            data: backupData.tables.customers
          });
        }

        // Restore Barbers
        if (backupData.tables.barbers) {
          console.log('📋 بازیابی آرایشگران...');
          await prisma.barber.createMany({
            data: backupData.tables.barbers
          });
        }

        // Restore Services
        if (backupData.tables.services) {
          console.log('📋 بازیابی خدمات...');
          await prisma.service.createMany({
            data: backupData.tables.services
          });
        }

        // Restore Financial Categories
        if (backupData.tables.financialCategories) {
          console.log('📋 بازیابی دسته‌بندی‌های مالی...');
          // TODO: Accounting functionality temporarily disabled
          // await prisma.financialCategory.createMany({
            // data: backupData.tables.financialCategories
          // });
        }

        // Restore Bank Accounts (BEFORE financial entries to avoid FK constraint)
        if (backupData.tables.bankAccounts && backupData.tables.bankAccounts.length > 0) {
          console.log('📋 بازیابی حساب‌های بانکی...');
          console.log(`📊 تعداد حساب‌های بانکی: ${backupData.tables.bankAccounts.length}`);
          await prisma.bankAccount.createMany({
            data: backupData.tables.bankAccounts
          });
        }

        // Restore Financial Entries (AFTER bank accounts)
        if (backupData.tables.financialEntries && backupData.tables.financialEntries.length > 0) {
          console.log('📋 بازیابی ورودی‌های مالی...');
          console.log(`📊 تعداد ورودی‌های مالی: ${backupData.tables.financialEntries.length}`);
          
          // بررسی و فیلتر کردن ورودی‌هایی که bankAccountId معتبر دارند
          const validEntries = backupData.tables.financialEntries.filter(entry => {
            if (entry.bankAccountId) {
              const bankAccountExists = backupData.tables.bankAccounts?.some(
                bank => bank.id === entry.bankAccountId
              );
              if (!bankAccountExists) {
                console.log(`⚠️ ورودی مالی با ID ${entry.id} حذف شد - bankAccountId نامعتبر: ${entry.bankAccountId}`);
                return false;
              }
            }
            return true;
          });
          
          if (validEntries.length > 0) {
            // TODO: Accounting functionality temporarily disabled
            // await prisma.financialEntry.createMany({
              // data: validEntries
            // });
            console.log(`✅ ${validEntries.length} ورودی مالی با موفقیت بازیابی شد`);
          } else {
            console.log('⚠️ هیچ ورودی مالی معتبری برای بازیابی یافت نشد');
          }
        }

        // Restore Appointments (BEFORE transactions)
        if (backupData.tables.appointments && backupData.tables.appointments.length > 0) {
          console.log('📋 بازیابی نوبت‌ها...');
          console.log(`📊 تعداد نوبت‌ها: ${backupData.tables.appointments.length}`);
          await prisma.appointment.createMany({
            data: backupData.tables.appointments
          });
        }

        // Restore Transactions (AFTER appointments)
        if (backupData.tables.transactions && backupData.tables.transactions.length > 0) {
          console.log('📋 بازیابی تراکنش‌ها...');
          console.log(`📊 تعداد تراکنش‌ها: ${backupData.tables.transactions.length}`);
          await prisma.transaction.createMany({
            data: backupData.tables.transactions
          });
        }

        // Restore SMS Settings
        if (backupData.tables.smsSettings) {
          console.log('📋 بازیابی تنظیمات SMS...');
          await prisma.smsSettings.createMany({
            data: backupData.tables.smsSettings
          });
        }

        // Restore Permissions
        if (backupData.tables.permissions) {
          console.log('📋 بازیابی دسترسی‌ها...');
          await prisma.permission.createMany({
            data: backupData.tables.permissions
          });
        }

        // Restore Barber-Service Relationships
        if (backupData.tables.barberServices) {
          console.log('📋 بازیابی روابط آرایشگر-خدمات...');
          for (const relation of backupData.tables.barberServices) {
            await prisma.$executeRaw`
              INSERT INTO "_BarberToService" ("A", "B") VALUES (${relation.A}, ${relation.B})
            `;
          }
        }
      });

      console.log('✅ بازیابی از پشتیبان با موفقیت انجام شد');
      
      return {
        success: true,
        message: 'بازیابی از پشتیبان با موفقیت انجام شد',
        timestamp: backupData.timestamp,
        recordsRestored: Object.keys(backupData.tables).length
      };
    } catch (error) {
      console.error('❌ خطا در بازیابی از پشتیبان:', error);
      throw new Error('خطا در بازیابی از پشتیبان');
    }
  }

  private async clearAllData(prisma: any) {
    // Clear data in correct order to avoid foreign key constraint violations
    await prisma.tipTransaction.deleteMany();
    await prisma.transaction.deleteMany();
    await prisma.appointmentService.deleteMany();
    await prisma.appointment.deleteMany();
    await prisma.bankAccount.deleteMany();
    // TODO: Accounting functionality temporarily disabled
    // await prisma.financialEntry.deleteMany();
    await prisma.barberWithdrawalRequest.deleteMany();
    await prisma.salary.deleteMany();
    await prisma.barber.deleteMany();
    await prisma.customer.deleteMany();
    await prisma.service.deleteMany();
    // TODO: Accounting functionality temporarily disabled
    // await prisma.financialCategory.deleteMany();
    await prisma.profile.deleteMany();
    await prisma.smsLog.deleteMany();
    await prisma.smsTemplate.deleteMany();
    await prisma.smsSettings.deleteMany();
    await prisma.setting.deleteMany();
    await prisma.permission.deleteMany();
    await prisma.user.deleteMany();
    
    // Clear many-to-many relationships
    await prisma.$executeRaw`DELETE FROM "_BarberToService"`;
  }

  async getBackupInfo() {
    try {
      const counts = {
        users: await this.prisma.user.count(),
        customers: await this.prisma.customer.count(),
        barbers: await this.prisma.barber.count(),
        services: await this.prisma.service.count(),
        appointments: await this.prisma.appointment.count(),
        // TODO: Accounting functionality temporarily disabled
        // financialEntries: await this.prisma.financialEntry.count(),
        transactions: await this.prisma.transaction.count(),
      };

      return {
        totalRecords: Object.values(counts).reduce((a, b) => a + b, 0),
        tableCounts: counts,
        lastBackup: null, // TODO: Implement backup history
        databaseSize: await this.getDatabaseSize(),
      };
    } catch (error) {
      console.error('❌ خطا در دریافت اطلاعات پشتیبان:', error);
      throw new Error('خطا در دریافت اطلاعات پشتیبان');
    }
  }

  private async getDatabaseSize() {
    try {
      const result = await this.prisma.$queryRaw`
        SELECT pg_size_pretty(pg_database_size(current_database())) as size
      `;
      return result[0]?.size || 'Unknown';
    } catch (error) {
      return 'Unknown';
    }
  }
}
