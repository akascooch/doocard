# Development Environment Variables for Doocard Backend (local PostgreSQL 17)

# Application
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Database
DATABASE_URL=postgresql://postgres:Lord7know$@localhost:5432/doocard?schema=public
POSTGRES_DB=doocard
POSTGRES_USER=postgres
POSTGRES_PASSWORD=Lord7know$
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis (optional for development)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-here-make-it-very-long-and-random
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=your-refresh-secret-key-here
JWT_REFRESH_EXPIRES_IN=365d

# CORS & Security
# Local:
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
FRONTEND_URL=http://localhost:3000
# Production example (set on server — do not leave localhost-only):
# CORS_ORIGIN=https://www.doocardbarbershop.com,https://doocardbarbershop.com,http://45.159.114.60:3000
# ALLOWED_ORIGINS=https://www.doocardbarbershop.com,https://doocardbarbershop.com
# FRONTEND_URL=https://www.doocardbarbershop.com
TRUST_PROXY=false

# VAPID Keys for Push Notifications (generate unique keys per environment)
# Leave empty in local if push is not needed; set real keys in production.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:support@doocardbarbershop.com

# File Upload
UPLOAD_DEST=./uploads
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf

# SMS Configuration (disabled for development — leave empty for safe local testing)
# For appointment-created SMS (IPPANEL Edge): SMS_API_KEY + SMS_SENDER_NUMBER / SMS_ORIGINATOR
SMS_API_KEY=
SMS_CUSTOMER_API_KEY=
SMS_SENDER_NUMBER=
SMS_ORIGINATOR=
SMS_LINE_NUMBER=
SMS_ENABLED=false
SMS_BEFORE_APPOINTMENT=60
SMS_AFTER_APPOINTMENT=0

# Email Configuration (disabled for development)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@your-domain.com

# Monitoring & Logging
LOG_LEVEL=debug
LOG_FILE=./logs/app.log
ENABLE_METRICS=false
PROMETHEUS_PORT=9090

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=1000

# Cache
CACHE_TTL=3600
CACHE_MAX_ITEMS=1000

# Session
SESSION_SECRET=your-session-secret-key-here
SESSION_TTL=86400

# Health Check
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=5000

# Backup
BACKUP_ENABLED=false
BACKUP_INTERVAL=86400
BACKUP_RETENTION_DAYS=30

# External Services
PAYMENT_GATEWAY_URL=https://payment-gateway.com
PAYMENT_GATEWAY_API_KEY=your-payment-api-key

# Feature Flags
ENABLE_SMS=false
ENABLE_EMAIL=false
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_ANALYTICS=false
ENABLE_BACKUP=false
