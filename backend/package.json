{
  "name": "doocard-backend",
  "version": "2.0.6",
  "description": "Backend for Doocard Beauty Salon Management System",
  "main": "dist/main.js",
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "scripts": {
    "start": "node --max-old-space-size=4096 node_modules/@nestjs/cli/bin/nest.js start",
    "start:dev": "node --max-old-space-size=4096 node_modules/@nestjs/cli/bin/nest.js start --watch",
    "start:debug": "node --max-old-space-size=4096 --inspect node_modules/@nestjs/cli/bin/nest.js start --debug --watch",
    "start:prod": "npm run build && node --max-old-space-size=4096 dist/main",
    "build": "node --max-old-space-size=4096 node_modules/@nestjs/cli/bin/nest.js build",
    "build:prod": "npm run build && npm run prisma:generate",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "lint:check": "eslint \"src/**/*.ts\"",
    "test": "jest",
    "test:unit": "npm run test:db:setup && jest --testPathPattern=spec.ts",
    "test:integration": "npm run test:db:setup && jest --testPathPattern=integration.spec.ts",
    "test:watch": "npm run test:db:setup && jest --watch",
    "test:cov": "npm run test:db:setup && jest --coverage",
    "test:cov:open": "npm run test:db:setup && jest --coverage && open coverage/lcov-report/index.html",
    "test:debug": "npm run test:db:setup && node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:all": "npm run test:unit && npm run test:integration",
    "test:ci": "npm run test:db:setup && npm run test:unit -- --coverage --watchAll=false",
    "test:watch:unit": "npm run test:db:setup && jest --testPathPattern=spec.ts --watch",
    "test:watch:integration": "npm run test:db:setup && jest --testPathPattern=integration.spec.ts --watch",
    "test:db:setup": "ts-node scripts/setup-test-database.ts",
    "test:db:reset": "ts-node scripts/reset-test-database.ts",
    "test:db:clean": "ts-node scripts/reset-test-database.ts",
    "test:restore": "jest --testPathPattern=\"backup-restore|backup\\.service\\.spec\" --watchAll=false",
    "test:restore:integration": "node -e \"if(process.env.NODE_ENV==='production'){console.error('Refusing integration restore tests in production');process.exit(1)}\" && npx ts-node scripts/qa-backup-restore-test.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:reset": "prisma migrate reset",
    "prisma:seed": "ts-node prisma/seed.ts",
    "prisma:seed-customers": "ts-node prisma/seed-customers.ts",
    "prisma:clear": "ts-node scripts/clear-database.ts",
    "prisma:reset": "ts-node prisma/resetDatabase.ts --confirm",
    "prisma:reset:dry": "ts-node prisma/resetDatabase.ts --dry-run",
    "prisma:reset:test": "ts-node prisma/resetDatabases.ts --test",
    "prisma:reset:both": "ts-node prisma/resetDatabases.ts --both --confirm",
    "prisma:reset:both:dry": "ts-node prisma/resetDatabases.ts --both --dry-run",
    "prisma:create-admin": "ts-node scripts/create-admin.ts",
    "setup:production": "node setup-production.js",
    "prisma:full-reset": "ts-node scripts/full-reset.ts",
    "prisma:setup-doocard": "ts-node scripts/setup-doocard-database.ts",
    "prisma:setup-production": "ts-node scripts/setup-doocard-production.ts",
    "prisma:studio": "prisma studio --port 5555",
    "import:historical:dry": "ts-node -r tsconfig-paths/register scripts/import-historical.ts --dry",
    "import:historical": "ts-node -r tsconfig-paths/register scripts/import-historical.ts",
    "ledger:backfill:dry": "ts-node -r tsconfig-paths/register scripts/backfill-employee-ledger.ts",
    "ledger:backfill:apply": "ts-node -r tsconfig-paths/register scripts/backfill-employee-ledger.ts --apply",
    "ledger:backfill:apply-inactive": "ts-node -r tsconfig-paths/register scripts/backfill-employee-ledger.ts --apply --create-inactive",
    "import:migration:dry-run": "ts-node scripts/import-migration/run-import.ts --dry-run",
    "import:migration:commit": "ts-node scripts/import-migration/run-import.ts --commit --create-missing",
    "import:migration:reset:dry": "ts-node scripts/import-migration/reset-domain.ts --dry-run",
    "import:migration:reset": "ts-node scripts/import-migration/reset-domain.ts --confirm",
    "import:migration:rollback:dry": "ts-node scripts/import-migration/rollback.ts --dry-run",
    "docker:build": "docker build -t barbershop-backend .",
    "docker:run": "docker run -p 3001:3001 barbershop-backend",
    "docker:compose:up": "docker-compose up -d",
    "docker:compose:down": "docker-compose down",
    "docker:compose:logs": "docker-compose logs -f",
    "logs:clear": "rm -rf logs/*",
    "clean": "rimraf dist node_modules package-lock.json",
    "preinstall": "npm run prisma:generate",
    "postinstall": "npm run prisma:generate"
  },
  "dependencies": {
    "@aspianet/faraz-sms": "^1.1.1",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/bull": "^11.0.4",
    "@nestjs/cache-manager": "^2.1.1",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.20",
    "@nestjs/platform-socket.io": "^10.4.20",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/serve-static": "^4.0.2",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/websockets": "^10.4.20",
    "@prisma/client": "^6.19.2",
    "@types/jalaali-js": "^1.2.0",
    "@types/passport-local": "^1.0.38",
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "bull": "^4.16.5",
    "cache-manager": "^5.4.0",
    "cache-manager-redis-store": "^3.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "dayjs": "^1.11.18",
    "exceljs": "^4.4.0",
    "helmet": "^7.1.0",
    "jalaali-js": "^1.2.8",
    "libphonenumber-js": "^1.12.25",
    "multer": "^1.4.5-lts.1",
    "nest-winston": "^1.10.2",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.1.13",
    "rimraf": "^5.0.0",
    "rxjs": "^7.8.0",
    "socket.io": "^4.8.1",
    "swagger-ui-express": "^5.0.1",
    "web-push": "^3.6.7",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^4.7.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^4.17.22",
    "@types/jest": "^29.0.0",
    "@types/multer": "^1.4.13",
    "@types/node": "^20.19.4",
    "@types/passport-jwt": "^3.0.13",
    "@types/supertest": "^6.0.0",
    "@types/web-push": "^3.6.4",
    "jest": "^29.0.0",
    "prisma": "^6.19.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.0.0",
    "ts-loader": "^9.4.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": "20.11.1",
    "npm": ">=10.0.0"
  },
  "engineStrict": true
}
