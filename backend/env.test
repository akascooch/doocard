# Test Environment Configuration
NODE_ENV=test
PORT=3001

# Test Database Configuration
DATABASE_URL="postgresql://postgres:Lord7know$@localhost:5433/MOVA_TEST?schema=public"

# JWT Configuration for Testing
JWT_SECRET="test-jwt-secret-key-for-testing-only"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_SECRET="test-refresh-secret-key-for-testing-only"
JWT_REFRESH_EXPIRES_IN="7d"

# Security Configuration
BCRYPT_ROUNDS=4
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Rate Limiting (relaxed for testing)
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=1000

# Redis Configuration
REDIS_URL=redis://localhost:6379

# SMS Configuration (disabled for testing)
SMS_ENABLED=false
SMS_PROVIDER=kavenegar
SMS_API_KEY="test-sms-api-key"
SMS_TEMPLATE_ID="test-template-id"

# Email Configuration (disabled for testing)
EMAIL_ENABLED=false

# Logging Configuration
LOG_LEVEL=error
LOG_FILE_PATH=logs/test.log

# Performance Configuration
COMPRESSION_LEVEL=1
CACHE_TTL=60

# Monitoring Configuration (disabled for testing)
ENABLE_METRICS=false
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=5

# File Upload Configuration
UPLOAD_DEST=./uploads/test
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf

# Backup Configuration (disabled for testing)
BACKUP_ENABLED=false

# Frontend URL
NEXT_PUBLIC_API_URL=http://localhost:3001
