{
  "name": "doocard",
  "version": "1.2.4",
  "description": "Professional Beauty Salon Management Software - Unified Backend & Frontend",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run start:dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "cd backend && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "start": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "start:backend": "cd backend && npm run start:prod",
    "start:frontend": "cd frontend && npm run start",
    "test": "npm run test:full",
    "test:full": "npm run test:backend && npm run test:frontend",
    "test:backend": "cd backend && npm run test:all",
    "test:frontend": "cd frontend && npm run test:e2e:ci",
    "test:backend:unit": "cd backend && npm run test:unit",
    "test:backend:integration": "cd backend && npm run test:integration",
    "test:backend:coverage": "cd backend && npm run test:cov",
    "test:frontend:open": "cd frontend && npm run test:e2e:open",
    "test:frontend:coverage": "cd frontend && npm run test:coverage",
    "test:watch": "concurrently \"npm run test:watch:backend\" \"npm run test:watch:frontend\"",
    "test:watch:backend": "cd backend && npm run test:watch",
    "test:watch:frontend": "cd frontend && npm run test:e2e:open",
    "test:db:setup": "cd backend && npm run test:db:setup",
    "test:db:reset": "cd backend && npm run test:db:reset",
    "test:db:clean": "cd backend && npm run test:db:clean",
    "lint": "npm run lint:backend && npm run lint:frontend",
    "lint:backend": "cd backend && npm run lint",
    "lint:frontend": "cd frontend && npm run lint",
    "format": "npm run format:backend && npm run format:frontend",
    "format:backend": "cd backend && npm run format",
    "format:frontend": "cd frontend && npm run lint -- --fix",
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install",
    "clean": "npm run clean:backend && npm run clean:frontend",
    "clean:backend": "cd backend && rm -rf dist node_modules/.cache coverage",
    "clean:frontend": "cd frontend && rm -rf .next node_modules/.cache cypress/videos cypress/screenshots cypress/coverage",
    "db:generate": "cd backend && npm run prisma:generate",
    "db:migrate": "cd backend && npm run prisma:migrate:deploy",
    "db:reset": "cd backend && npm run prisma:reset",
    "db:reset:dry": "cd backend && npm run prisma:reset:dry",
    "db:reset:test": "cd backend && npm run prisma:reset:test",
    "db:reset:both": "cd backend && npm run prisma:reset:both",
    "db:reset:both:dry": "cd backend && npm run prisma:reset:both:dry",
    "db:seed": "cd backend && npm run prisma:seed",
    "db:studio": "cd backend && npm run prisma:studio",
    "db:seed:admin": "ts-node backend/prisma/seedAdmin.ts",
    "docker:dev": "docker-compose -f docker-compose.dev.yml up -d",
    "docker:prod": "docker-compose -f docker-compose.production.yml up -d",
    "docker:down": "docker-compose down",
    "docker:build": "docker-compose build",
    "setup": "npm run install:all && npm run db:generate && npm run db:migrate",
    "setup:dev": "npm run setup && npm run dev",
    "health": "npm run health:backend && npm run health:frontend",
    "health:backend": "curl -f http://localhost:3001/api/health || echo 'Backend not running'",
    "db:seed:admin:reset": "cd backend && npx ts-node prisma/seedAdmin.ts && npx ts-node scripts/reset-admin-password.ts",
    "health:frontend": "curl -f http://localhost:3000 || echo 'Frontend not running'",
    "logs": "concurrently \"npm run logs:backend\" \"npm run logs:frontend\"",
    "logs:backend": "cd backend && npm run logs",
    "logs:frontend": "cd frontend && npm run logs"
  },
  "devDependencies": {
    "concurrently": "^7.6.0",
    "cross-env": "^7.0.3",
    "wait-on": "^7.2.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "keywords": [
    "beauty-salon",
    "management-software",
    "appointment-booking",
    "customer-management",
    "nestjs",
    "nextjs",
    "typescript",
    "prisma",
    "postgresql"
  ],
  "author": "Doocard Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/doocard/doocard.git"
  },
  "bugs": {
    "url": "https://github.com/doocard/doocard/issues"
  },
  "homepage": "https://github.com/doocard/doocard#readme",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "is-glob": "^4.0.3",
    "jalaali-js": "^1.2.8",
    "jalaliday": "^3.1.1",
    "react-date-object": "^2.1.9",
    "react-multi-date-picker": "^4.5.2"
  }
}
